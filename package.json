{
  "name": "hakiwork",
  "version": "1.0.0",
  "description": "打工哈基米 - 离线轻量化插件化批量工具箱",
  "main": "dist/main/index.js",
  "author": "HakiWork Team",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "node haki.js dev",
    "dev:main": "tsc -p tsconfig.main.json && npx tsc-alias -p tsconfig.main.json && electron .",
    "dev:renderer": "vite",
    "build": "node haki.js build",
    "build:main": "tsc -p tsconfig.main.json && npx tsc-alias -p tsconfig.main.json",
    "build:renderer": "vite build --mode renderer",
    "pack": "npm run build && electron-builder win --x64",
    "dist": "npm run build && electron-builder",
    "test": "node haki.js",
    "test:fast": "node scripts/test.js --skip-build",
    "test:build": "node scripts/test.js --build-only",
    "start": "node haki.js"
  },
  "dependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "electron-store": "^8.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "tsc-alias": "^1.9.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.9",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  }
}